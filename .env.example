RAWG_API_KEY=
SCAN_ENABLE=true
SCAN_CRON=0 3 * * *
SCAN_THROTTLE_MS=50
SCAN_WEEKLY_FULL_CHECK=false
# 飞牛 WebDAV 在容器内的挂载目录；默认 /vol/baidu。
SCAN_ROOT=/vol/baidu

# 挂载源并发直读线程数（4~8 最佳）。
FUSE_THREADS=8

# 下载方式：internal=内置下载 / external=外置下载（aria2，需另行部署，见 README「外置下载」）。
DOWNLOAD_ENGINE=internal
# 仅 external 时需要：
ARIA_RPC=http://192.168.20.10:6800/jsonrpc
ARIA_SECRET=
